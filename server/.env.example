# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/deadlinehub?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Frontend Client URL (CORS & Socket.IO)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=https://deadlinehub-one.vercel.app,http://localhost:5173

# Real Email Delivery Configuration (SMTP)
# Configure these with your email provider (e.g. Gmail, Brevo, SendGrid, Mailgun, AWS SES, or custom SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="DeadlineHub <noreply@deadlinehub.com>"
